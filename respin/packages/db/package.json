{
  "name": "@respin/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./deletion-journal-s3": "./src/deletion-journal-s3.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/seed-cli.ts",
    "proposals:audit": "tsx src/proposal-audit-cli.ts",
    "sample-spin:keyring": "tsx src/sample-spin-keyring-cli.ts",
    "test:concurrency": "vitest run --root ../.. packages/db/tests/concurrency.docker.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@respin/brain": "workspace:*",
    "better-auth": "^1.6.28",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "uuidv7": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
