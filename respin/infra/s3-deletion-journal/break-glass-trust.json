{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequireSameAccountIAMOperatorWithMFA",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::770371751912:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::770371751912:user/*"
        }
      }
    }
  ]
}
