{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutdown.local/skills/propose/output.json",
  "title": "ProposeResult",
  "description": "A TAGGED UNION: propose either produced briefs, refused with a reason (REQ-036), or skipped because the gateway is not configured. Distinct states, never one smuggled inside another.",
  "type": "object",
  "oneOf": [
    {
      "title": "ProposedBriefs",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jobId", "count", "briefs"],
      "properties": {
        "kind": { "type": "string", "const": "briefs" },
        "jobId": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "briefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["creativeBriefId", "path", "semanticAngleLabel", "sharedMomentFraction"],
            "properties": {
              "creativeBriefId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
              "path": { "type": "string", "minLength": 1, "description": "Path to the committed CreativeBrief, relative to the job directory." },
              "semanticAngleLabel": { "type": "string", "minLength": 1 },
              "sharedMomentFraction": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    {
      "title": "Refusal",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jobId", "missing", "narrowerSuggestion"],
      "properties": {
        "kind": { "type": "string", "const": "refusal" },
        "jobId": { "type": "string", "minLength": 1 },
        "missing": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "narrowerSuggestion": { "type": "string", "minLength": 1 },
        "feasibleVariants": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "Skipped",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "reason"],
      "properties": {
        "kind": { "type": "string", "const": "skipped" },
        "code": { "type": "string", "const": "MODEL_NOT_CONFIGURED" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
