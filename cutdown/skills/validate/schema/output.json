{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutdown.local/skills/validate/output.json",
  "title": "ValidateResult",
  "description": "The overall validate result. gateStatus comes ONLY from the deterministic blockers (D-37). A 'fail' is a valid result, not a skill error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "jobId", "edlId", "gateStatus", "blockerCount", "deterministicAdvisoryCount", "gatePath", "criticPath", "critic"],
  "properties": {
    "kind": { "type": "string", "const": "validated" },
    "jobId": { "type": "string", "minLength": 1 },
    "edlId": { "type": "string", "minLength": 1 },
    "gateStatus": { "type": "string", "enum": ["pass", "fail"] },
    "blockerCount": { "type": "integer", "minimum": 0 },
    "deterministicAdvisoryCount": { "type": "integer", "minimum": 0 },
    "gatePath": { "type": "string", "minLength": 1, "description": "Path to the persisted deterministic gate result, relative to the job directory." },
    "criticPath": { "type": "string", "minLength": 1, "description": "Path to the persisted advisory critic result, relative to the job directory." },
    "critic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ran", "skipped"] },
        "findingCount": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
