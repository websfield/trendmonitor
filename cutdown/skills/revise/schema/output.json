{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutdown.local/skills/revise/output.json",
  "title": "ReviseResult",
  "description": "A TAGGED UNION of the three honest outcomes: a revision was made, the note could not be pinned to an object, or the gateway is not configured. Distinct states, never one smuggled inside another.",
  "type": "object",
  "oneOf": [
    {
      "title": "Revised",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jobId", "target", "targetRationale", "newObjectId", "parentObjectId", "objectPath", "constraints", "applied", "unapplied", "reindexed"],
      "properties": {
        "kind": { "type": "string", "const": "revised" },
        "jobId": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "enum": ["platform-edl", "master-story-plan", "creative-brief"],
          "description": "The NARROWEST object that could satisfy every constraint (REQ-039), computed deterministically from the constraint kinds — never chosen by the model."
        },
        "targetRationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this object and not a narrower one, citing the constraint that forced it."
        },
        "newObjectId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "parentObjectId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "REQ-113: every revision links its parent, and the parent stays on disk and reproducible."
        },
        "objectPath": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "description": "The interpreted constraints, shown so the reviewer can check them against their own words (REQ-112).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject", "instruction", "sourceText"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "instruction": { "type": "string", "minLength": 1 },
              "sourceText": { "type": "string", "minLength": 1 }
            }
          }
        },
        "applied": {
          "type": "array",
          "description": "What actually changed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject", "change"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "change": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unapplied": {
          "type": "array",
          "description": "Constraints the deterministic applier could not perform, each WITH its reason. Reported rather than silently dropped — a revision that claimed to act on a note it ignored is worse than one that says what it could not do.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject", "reason"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reindexed": {
          "type": "boolean",
          "const": false,
          "description": "REQ-039's other half, asserted in the contract: a revision reuses the source index. `const: false` makes a re-indexing revision unrepresentable rather than merely discouraged."
        }
      }
    },
    {
      "title": "NeedsConfirmation",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jobId", "unresolved", "constraints"],
      "properties": {
        "kind": { "type": "string", "const": "needs_confirmation" },
        "jobId": { "type": "string", "minLength": 1 },
        "unresolved": {
          "type": "array",
          "minItems": 1,
          "description": "Note fragments that could not be pinned to a specific object. A guess here would silently re-cut an approved video.",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "description": "What WAS interpreted, so the reviewer can confirm the rest rather than restate everything.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject", "instruction", "sourceText"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "instruction": { "type": "string", "minLength": 1 },
              "sourceText": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "title": "Skipped",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "reason"],
      "properties": {
        "kind": { "type": "string", "const": "skipped" },
        "code": { "type": "string", "const": "MODEL_NOT_CONFIGURED" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
