{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutdown.local/skills/ingest/output.json",
  "title": "IngestResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "inventoryId", "assetCount", "assets", "warnings", "cacheHits", "ffmpegVersion"],
  "properties": {
    "jobId": { "type": "string", "minLength": 1 },
    "inventoryId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "assetCount": { "type": "integer", "minimum": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "IngestedAssetSummary",
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "relativePath", "assetKind", "rightsState", "storedPath", "proxyPath", "cacheHit"],
        "properties": {
          "assetId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "relativePath": { "type": "string", "minLength": 1 },
          "assetKind": {
            "type": "string",
            "enum": ["video", "audio", "image", "logo", "subtitle", "brand_reference"]
          },
          "rightsState": { "type": "string", "enum": ["cleared", "unknown", "restricted", "expired"] },
          "storedPath": { "type": "string", "minLength": 1 },
          "proxyPath": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
          "cacheHit": { "type": "boolean" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "cacheHits": {
      "type": "integer",
      "minimum": 0,
      "description": "REQ-005 cache-hit count. tech-spec §13 wants this visible from the first real job — it is the single cheapest lever on both cost and latency."
    },
    "ffmpegVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Recorded per ingest so the D-33 pinned-local-environment claim is evidenced by the artefact, not asserted by the developer."
    }
  }
}
