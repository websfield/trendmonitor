# cutdown/.env.example — copy to cutdown/.env and fill in (decisions.md D-21).
#
# cutdown/.env is GITIGNORED and read ONLY by the local CLI process; the API key
# never enters an artefact, a log, or an error (the gateways scrub it). This
# .env.example carries NO secrets and IS committed.
#
# The two OWNER inputs that unblock live model calls (PHASE_3_ACCEPTED_LIVE):
#   1. ANTHROPIC_API_KEY      — your Anthropic key (a secret; never commit it).
#   2. CUTDOWN_SPEND_CEILING_AUD — the Phase 0 spend ceiling in AUD. NO DEFAULT:
#        until BOTH the key and this ceiling are set, every paid model call is
#        SKIPPED (fail-closed, D-21) and the editorial chain reports awaiting/skipped.
#        Pick a real cap you are comfortable spending against your account.

# --- credential -------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- spend gate (D-21) — set to enable any paid call --------------------------
CUTDOWN_SPEND_CEILING_AUD=50

# --- provider / model (defaults shown; override only to swap provider) --------
CUTDOWN_MODEL_PROVIDER=anthropic
CUTDOWN_MODEL_BASE_URL=https://api.anthropic.com
CUTDOWN_MODEL_TIMEOUT_SECONDS=60

# Editorial stages (propose / plan / validate critic) — packages/editorial gateway
CUTDOWN_EDITORIAL_MODEL_ID=claude-sonnet-5
CUTDOWN_EDITORIAL_MAX_OUTPUT_TOKENS=4096

# Visual-description (VLM) sub-stage of `index` — workers/indexer-python gateway
CUTDOWN_VLM_MODEL_ID=claude-sonnet-5
CUTDOWN_VLM_MAX_KEYFRAMES=3
CUTDOWN_VLM_MAX_OUTPUT_TOKENS=512
